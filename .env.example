# ==============================================================================
# DataSage — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in values for your environment.
# Never commit .env to version control.
# See docs/25-environment-configuration.md for full details.
# ==============================================================================

# --- Application -----------------------------------------------------------
APP_NAME=DataSage
APP_ENV=development                          # development | staging | production
APP_DEBUG=true                               # Disable in production
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=DEBUG                          # DEBUG | INFO | WARNING | ERROR
APP_SECRET_KEY=change-me-to-a-random-string  # Used for general signing; ≥32 chars

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_APP_NAME=DataSage

# --- Database (PostgreSQL + PostGIS) ----------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=datasage
POSTGRES_USER=datasage
POSTGRES_PASSWORD=change-me                  # Use a strong password in production
POSTGRES_POOL_SIZE=10                        # Connection pool size
POSTGRES_MAX_OVERFLOW=20                     # Max overflow connections

# Constructed by the app; shown here for reference:
# DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Redis -------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                              # Set in production
REDIS_DB=0
REDIS_CACHE_TTL_SECONDS=3600                 # Default cache TTL: 1 hour

# --- JWT Authentication ------------------------------------------------------
JWT_SECRET_KEY=change-me-to-another-random-string  # ≥64 chars, separate from APP_SECRET_KEY
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000           # Comma-separated; restrict in production
CORS_ALLOW_CREDENTIALS=true

# --- OpenStreetMap / Overpass API --------------------------------------------
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=30
OVERPASS_MAX_RETRIES=3
# For heavy usage, consider hosting your own Overpass instance:
# OVERPASS_API_URL=http://overpass.local:12345/api/interpreter

# --- ML Model Configuration --------------------------------------------------
ML_MODEL_DIR=./ml/models                    # Directory containing serialized models
ML_VALUATION_MODEL_NAME=valuation_xgb_v1.joblib
ML_PREDICTION_CACHE_TTL=86400               # Cache predictions for 24 hours
ML_BATCH_SIZE=100                            # Batch size for bulk predictions
ML_MIN_CONFIDENCE_THRESHOLD=0.6             # Minimum confidence to serve a prediction

# --- Geospatial Configuration ------------------------------------------------
GEO_DEFAULT_SRID=4326                       # WGS 84
GEO_SEARCH_RADIUS_METERS=5000               # Default POI search radius
GEO_DELHI_NCR_BBOX=28.3,76.8,28.9,77.6     # Bounding box: lat_min,lon_min,lat_max,lon_max

# --- Rate Limiting ------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute               # Default per-user rate limit
RATE_LIMIT_AUTH=10/minute                    # Login/signup endpoint rate limit
RATE_LIMIT_ML=20/minute                     # ML prediction endpoint rate limit

# --- Email (for future password reset, notifications) ------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@datasage.dev
# SMTP_TLS=true

# --- Sentry (Error Tracking — Production Only) --------------------------------
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Docker Compose Overrides ------------------------------------------------
# These are used by docker-compose.yml and can be overridden here
DOCKER_POSTGRES_PORT=5432
DOCKER_REDIS_PORT=6379
DOCKER_BACKEND_PORT=8000
DOCKER_FRONTEND_PORT=3000
